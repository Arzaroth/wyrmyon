# Maintainer: Marc-Etienne Barrut <anthropic@barrut.me>
#
# Repackages the static musl binaries of a GitHub release. The release
# workflow attaches a copy of this file with pkgver and sha256sums filled in,
# and the packages it builds from it.

pkgname=wyrmyon-bin
pkgver=0.1.0
pkgrel=1
pkgdesc="A magic-wormhole client that switches to iroh when both peers run wyrmyon (static binary)"
arch=('x86_64' 'aarch64')
url="https://github.com/Arzaroth/wyrmyon"
license=('MIT')
provides=("wyrmyon=$pkgver" 'wyrm')
conflicts=('wyrmyon')
options=('!strip' '!debug')
source_x86_64=("$url/releases/download/v$pkgver/wyrmyon-v$pkgver-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/wyrmyon-v$pkgver-aarch64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  cd "wyrmyon-v$pkgver-$CARCH-unknown-linux-musl"
  install -Dm755 wyrmyon "$pkgdir/usr/bin/wyrmyon"
  ln -s wyrmyon "$pkgdir/usr/bin/wyrm"
  install -Dm644 -t "$pkgdir/usr/share/man/man1" man/*.1
  for bin in wyrmyon wyrm; do
    install -Dm644 "completions/$bin.bash" "$pkgdir/usr/share/bash-completion/completions/$bin"
    install -Dm644 "completions/_$bin" "$pkgdir/usr/share/zsh/site-functions/_$bin"
    install -Dm644 "completions/$bin.fish" "$pkgdir/usr/share/fish/vendor_completions.d/$bin.fish"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
